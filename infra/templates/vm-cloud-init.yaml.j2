#cloud-config
package_update: true
packages:
  - wget
  - gpg
  - xfce4
  - xfce4-session
  - xrdp
runcmd:
  - adduser xrdp ssl-cert
  - echo xfce4-session > /home/{{ vm_admin_username }}/.xsession
  - chown {{ vm_admin_username }}:{{ vm_admin_username }} /home/{{ vm_admin_username }}/.xsession
  - systemctl enable --now xrdp
  - apt-get update
  - apt-get install -y firefox
