[Unit]
Description=Mount rse-demo-container via BlobFuse2 (managed identity)
After=network-online.target
Requires=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/blobfuse2 mount {{ mount_path }} \
    --config-file={{ config_path }} --read-only=true
ExecStop=/usr/bin/blobfuse2 unmount {{ mount_path }}
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
